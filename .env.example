# ─────────────────────────────────────────────────────────────────────────────
# GAIA — Growth AI Agent · Environment Variables
# Copy this file to .env and fill in your values.
# Rule: NEVER hardcode credentials. This file is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Company Identity (set during Onboarding Wizard) ──────────────────────────
COMPANY_NAME=
COMPANY_WEBSITE=
INDUSTRY=
COMPANY_STAGE=                      # startup | scaleup | enterprise

# ── Core LLM (Primary Reasoning Engine) ──────────────────────────────────────
# GAIA uses Gemini as its primary brain.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro         # or gemini-2.0-flash for faster/cheaper

# Fallback / image generation
OPENAI_API_KEY=

# ── Database (Postgres — task state, company config, content drafts) ──────────
POSTGRES_USER=gaia
POSTGRES_PASSWORD=gaiapassword
POSTGRES_DB=gaiadb
DATABASE_URL=postgresql+asyncpg://gaia:gaiapassword@localhost:5432/gaiadb

# ── Graphiti Memory (Neo4j — temporal knowledge graph) ───────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gaianeo4j

# ── Task Queue (Redis + Celery) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── n8n Automation ────────────────────────────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_ENCRYPTION_KEY=changeme_32chars_minimum_length!

# ── Search & Intelligence (Multi-Engine) ─────────────────────────────────────
# GAIA queries ALL configured engines and synthesizes the best answer.
TAVILY_API_KEY=                     # tavily.com — best for agents, free tier available
EXA_API_KEY=                        # exa.ai — semantic web search

# ── Content Channels (configure only what your stack uses) ───────────────────

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=                    # your company page ID

# Meta (Facebook & Instagram)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Email
SENDGRID_API_KEY=                   # sendgrid.com — free tier: 100/day
SENDGRID_FROM_EMAIL=
MAILCHIMP_API_KEY=                  # alternative to SendGrid
MAILCHIMP_LIST_ID=

# ── CRM ───────────────────────────────────────────────────────────────────────
# HubSpot (free tier is best-in-class)
HUBSPOT_API_KEY=

# Salesforce (optional)
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# ── Website / CMS ─────────────────────────────────────────────────────────────
# Ghost (self-hosted blog)
GHOST_URL=
GHOST_ADMIN_API_KEY=

# WordPress
WORDPRESS_API_URL=
WORDPRESS_APP_PASSWORD=

# ── Image Generation ──────────────────────────────────────────────────────────
# DALL-E 3 (falls back to OPENAI_API_KEY if not set separately)
DALLE_API_KEY=

# Stability AI (alternative)
STABILITY_API_KEY=

# ── Video Generation ─────────────────────────────────────────────────────────
# Higgsfield AI — user connects via MCP. GAIA prepares the request parameters.
HIGGSFIELD_API_KEY=                 # higgsfield.ai

# ── Calendar & Productivity MCPs ─────────────────────────────────────────────
# Google (Gmail, Calendar, Drive) — user provides OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Internal Security ─────────────────────────────────────────────────────────
SECRET_KEY=                         # min 32 chars — used to encrypt stored API keys
ENCRYPTION_KEY=                     # AES-256 key for at-rest credential encryption

# ── Agent Behavior ────────────────────────────────────────────────────────────
GAIA_API_PORT=8001
DAILY_DIGEST_TIME=09:00             # HH:MM in GENERIC_TIMEZONE
GENERIC_TIMEZONE=UTC
COST_ALERT_THRESHOLD_USD=50         # alert if monthly API spend exceeds this
