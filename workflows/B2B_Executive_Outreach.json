        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"CONTEXT FROM MEMORY:\\n{{ $('Validate & Filter').item.json.map ? $('Validate & Filter').item.json.map(item => item.content).join('\\\\n') : '' }}\\n\\nYou are Growth Engineering at CloudPulse. You are writing a personalised cold outreach email to a VP of Infrastructure, Head of Platform Engineering, or DevOps Director.\\n\\nRules:\\n1. Keep under 120 words. No filler, no hype.\\n2. Reference their company, infrastructure stack, or recent engineering blog post explicitly to show you did your research.\\n3. Core Pitch: CloudPulse delivers closed-loop eBPF cluster telemetry that automatically cuts unallocated Kubernetes compute costs by 35% without degrading production latency or availability SLAs.\\n4. Offer: Free 14-day staging cluster efficiency audit report.\\n5. CTA: Invite them to a brief 10-minute technical briefing next week.\\n6. Sign off cleanly: Growth Engineering, CloudPulse (cloudpulse.io).\\n\\nOUTPUT: Return ONLY a valid JSON object with exactly two keys: 'Subject' and 'Body'.\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Target Country: {{ $('Validate & Filter').item.json.Country || $('Validate & Filter').item.json.Region || 'Unknown' }}\\nContact Name: {{ $('Validate & Filter').item.json['Contact Name'] || $('Validate & Filter').item.json['Full Name'] }}\\nCompany: {{ $('Validate & Filter').item.json['Company Name'] || $('Validate & Filter').item.json.Company }}\\nTech Stack / Cloud: {{ $('Validate & Filter').item.json['Tech Stack'] || $('Validate & Filter').item.json.Infrastructure }}\\nEfficiency Pain Point: {{ $('Validate & Filter').item.json['Pain Point'] || $('Validate & Filter').item.json.Notes }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.7\n  }\n}",
        "options": {}
      },
