                },
                "conditions": [
                  {
                    "id": "is-seo-geo",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "SEO_GEO",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "SEO/GEO Agent"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "is-strategist",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "STRATEGIST",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "Content Strategist Agent"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
