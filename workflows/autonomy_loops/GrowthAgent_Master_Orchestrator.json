        "url": "={{ $('Discord Message In').item.json.body.webhookUrl || 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"\u26a0\ufe0f **GrowthAgent** | I didn't understand that request. Try something like:\\n- 'Write a LinkedIn post about motion capture for football'\\n- 'Draft cold emails to PT clinic directors in Munich'\\n- 'Write a blog about why 70% of PT patients quit'\\n- 'Draft this week's newsletter for CloudPulse'\\n- 'What are the latest trends in agentic LLM evaluation?'\\n- 'Give me an AI COO executive briefing'\"\n}",
        "options": {}
      },
