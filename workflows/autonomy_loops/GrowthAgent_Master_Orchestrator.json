{
  "name": "GrowthAgent - Master Orchestrator (Discord)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "GrowthAgent-jr-orchestrator",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Discord Message In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "GrowthAgent-jr-orchestrator",
      "notes": "Receives messages from the Discord Bot. The bot sends: { \"message\": \"...\", \"channelId\": \"...\" }"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-8b:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"You are GrowthAgent, the Master AI Orchestrator (CEO Brain) for CloudPulse and Synthetix AI.\\nYou receive tasks from the team via Discord.\\n\\nSTEP 1: Classify the task into exactly ONE category.\\nSTEP 2: Return a JSON object with two keys: 'category' and 'acknowledgment'.\\n\\nCategories:\\nB2B \u2014 emails, outreach, lead generation, university contacts\\nLINKEDIN \u2014 social media posts, LinkedIn content, announcements\\nBLOG \u2014 SEO articles, deep-dives, patient stories, case studies\\nNEWSLETTER \u2014 weekly email updates, Brevo campaigns, subscriber newsletters\\nTREND \u2014 trend research, industry news, competitor analysis, market signals\\nCOO \u2014 executive briefing, weekly report, telemetry, system status, agent health check\\nSEO_GEO \u2014 AI search visibility check, Perplexity/ChatGPT citation scorecard, Schema markup, Replit sandbox\\nSTRATEGIST \u2014 weekly content calendar, GTM editorial plan, content roadmap scheduling\\nUNKNOWN \u2014 if the request is unclear\\n\\nExample output:\\n{\\\"category\\\": \\\"SEO_GEO\\\", \\\"acknowledgment\\\": \\\"Got it! I'm routing your request to the SEO/GEO/AEO Specialist Agent to audit our AI search citations across ChatGPT and Perplexity. Results will be posted right here in this channel in ~1-2 minutes!\\\"}\\n\\nRules:\\n- 'acknowledgment' should be a friendly 1-2 sentence confirmation in GrowthAgent's voice.\\n- ALWAYS state that results will be posted right here in this channel.\\n- ALWAYS return valid JSON. No markdown wrapping.\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": {{ JSON.stringify($json.body.message || \"\") }}\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.05,\n    \"maxOutputTokens\": 256\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-gemini-router",
      "name": "Gemini 2.5 Flash (CEO Brain)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "parse-category",
              "name": "category",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text.replace(/```json|```/g, '').trim()).category.trim().toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "parse-ack",
              "name": "acknowledgment",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text.replace(/```json|```/g, '').trim()).acknowledgment }}",
              "type": "string"
            },
            {
              "id": "keep-channel",
              "name": "channelId",
              "value": "={{ $('Discord Message In').item.json.body.channelId }}",
              "type": "string"
            },
            {
              "id": "keep-message",
              "name": "originalMessage",
              "value": "={{ $('Discord Message In').item.json.body.message }}",
              "type": "string"
            },
            {
              "id": "keep-message-short",
              "name": "message",
              "value": "={{ $('Discord Message In').item.json.body.message }}",
              "type": "string"
            },
            {
              "id": "keep-brand",
              "name": "brand",
              "value": "={{ $('Discord Message In').item.json.body.message.toLowerCase().includes('Synthetix AI') ? 'Synthetix AI' : 'CloudPulse' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-parse-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Discord Message In').item.json.body.webhookUrl || 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"\ud83e\udd16 **GrowthAgent** | {{ $json.acknowledgment }}\"\n}",
        "options": {}
      },
      "id": "node-discord-ack",
      "name": "Discord: Send Acknowledgment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "notes": "Sends confirmation back to Discord so the user sees the response immediately."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "is-b2b",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "B2B",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputLabel": "B2B Agent"
            },
            {
