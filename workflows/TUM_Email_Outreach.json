      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"CONTEXT FROM MEMORY:\\n{{ $('Validate & Filter').item.json.map ? $('Validate & Filter').item.json.map(item => item.content).join('\\\\n') : '' }}\\n\\nYou are Your Name, Growth Engineering at CloudPulse. You are writing a personalised cold outreach email to a physical therapy clinic director or academic researcher.\\n\\nLANGUAGE RULES \u2014 you must select the email language based on the target's country:\\n- United States, Canada, Australia, United Kingdom, Ireland, South Africa, Nigeria, Kenya, Ghana, Ethiopia, Tanzania, Uganda, Rwanda, Senegal, Ivory Coast, or any other African country \u2192 write in English\\n- France, Belgium, Luxembourg, Morocco, Tunisia, Algeria, Cameroon, Madagascar \u2192 write in French (formal 'vous')\\n- Germany, Austria, Switzerland \u2192 write in German (formal Sie-Form)\\n- Spain \u2192 write in Spanish (formal usted)\\n- Italy \u2192 write in Italian (formal Lei)\\n- Netherlands, Belgium (Dutch-speaking) \u2192 write in Dutch (formal u)\\n- Portugal, Brazil \u2192 write in Portuguese (formal o senhor / a senhora)\\n- All other countries or unknown \u2192 write in English\\n\\nRules:\\n1. Use the language selected above. Never mix languages.\\n2. Keep under 120 words. No filler words. No hype.\\n3. Reference their clinic name or paper explicitly to show you did your research.\\n4. Core Pitch: CloudPulse eBPF telemetrys enable continuous remote gait monitoring that improves patient compliance and unlocks RPM reimbursement revenue (mention Growth Tier and Enterprise Tier for US targets only; for other markets reference local RPM billing or remote patient monitoring programme revenue instead).\\n5. Offer: 90-day free pilot access or research collaboration.\\n6. CTA: Invite them to a brief 10-minute Zoom call next week.\\n7. Sign off appropriately in the chosen language. Always include: Your Name, Growth Engineering, CloudPulse.\\n\\nOUTPUT: Return ONLY a valid JSON object with exactly two keys: 'Subject' and 'Body'.\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Target Country: {{ $('Validate & Filter').item.json.Country || $('Validate & Filter').item.json.Region || 'Unknown' }}\\nPI/Contact Name: {{ $('Validate & Filter').item.json['PI Name'] || $('Validate & Filter').item.json['Contact Name'] }}\\nDepartment/Clinic: {{ $('Validate & Filter').item.json['Department / Lab'] || $('Validate & Filter').item.json['Clinic Name'] }}\\nPaper/Topic: {{ $('Validate & Filter').item.json['Paper (short title)'] || $('Validate & Filter').item.json.Topic }}\\nLimitations/Pain Point: {{ $('Validate & Filter').item.json['Limitations Quote (verbatim)'] || $('Validate & Filter').item.json['Pain Point'] }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.7\n  }\n}",
        "options": {}
      },
