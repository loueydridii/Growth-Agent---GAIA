    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"You are the COO of GrowthAgent. Your job is to generate a Daily System Health Report. Structure the report precisely as follows:\\n\\nGrowthAgent HEALTH REPORT\\n\\nDATABASE HEALTH\\n- Pending Signals: [count]\\n- Queued Opportunities: [count]\\n- Drafts Awaiting Approval: [count]\\n\\nSYSTEM BOTTLENECKS\\n[List any queues that look backed up. If drafts are waiting, urge the human to approve them!]\\n\\nMARKETING PERFORMANCE\\n[Summarize the telemetry data]\\n\\nOutput in standard markdown.\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Telemetry:\\n\" + JSON.stringify($('Supabase: Fetch Recent Telemetry').item.json || []) + \"\\n\\nPending Signals:\\n\" + JSON.stringify($('Supabase: Fetch Pending Signals').item.json || []) + \"\\n\\nQueued Opps:\\n\" + JSON.stringify($('Supabase: Fetch Queued Opps').item.json || []) + \"\\n\\nPending Drafts:\\n\" + JSON.stringify($('Supabase: Fetch Pending HITL Drafts').item.json || [])\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.3\n  }\n} }}",
        "options": {}
      },
