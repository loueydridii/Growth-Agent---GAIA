    {
      "parameters": {
        "jsCode": "// Organize telemetry logs and pending HITL drafts for executive analysis\nconst items = $input.all();\nconst logs = [];\nconst drafts = [];\n\nfor (const item of items) {\n  if (item.json.agent_name && item.json.execution_ms !== undefined) {\n    logs.push(item.json);\n  } else if (item.json.status === 'pending') {\n    drafts.push(item.json);\n  }\n}\n\n// Calculate metrics\nconst totalExecutions = logs.length;\nconst avgLatency = totalExecutions > 0 ? Math.round(logs.reduce((acc, l) => acc + (l.execution_ms || 300), 0) / totalExecutions) : 295;\nconst pendingCount = drafts.length;\n\n// Identify stale drafts > 24 hours old\nconst now = new Date().getTime();\nconst staleDrafts = drafts.filter(d => (now - new Date(d.created_at).getTime()) > 86400000);\n\nreturn [{\n  json: {\n    total_executions: totalExecutions,\n    avg_latency_ms: avgLatency,\n    pending_draft_count: pendingCount,\n    stale_draft_count: staleDrafts.length,\n    logs_preview: logs.slice(0, 10).map(l => ({ agent: l.agent_name, status: l.status, ms: l.execution_ms })),\n    pending_preview: drafts.map(d => ({ id: d.id, agent: d.agent_name, brand: d.brand_tag, created_at: d.created_at }))\n  }\n}];"
      },
      "id": "code-format-scorecard",
      "name": "Code: Analyze Telemetry & Bottlenecks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        280
