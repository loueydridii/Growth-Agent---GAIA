        "options": {}
      },
      "id": "merge-feeds",
      "name": "Merge: Combine All Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        760,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate feed items by title and prepare for summarization\nconst seen = new Set();\nconst unique = [];\n\nfor (const item of $input.all()) {\n  const title = (item.json.title || '').trim().toLowerCase();\n  if (title && !seen.has(title)) {\n    seen.add(title);\n    unique.push({\n      json: {\n        title: item.json.title || 'Untitled',\n        link: item.json.link || item.json.url || '',\n        pubDate: item.json.pubDate || item.json.isoDate || '',\n        source: item.json.creator || item.json.source || 'Unknown',\n        snippet: (item.json.contentSnippet || item.json.content || '').substring(0, 500)\n      }\n    });\n  }\n}\n\n// Limit to 15 most recent items to stay within token limits\nreturn unique.slice(0, 15);"
      },
      "id": "code-dedup",
      "name": "Code: Deduplicate & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"contents\": [ { \"parts\": [ { \"text\": \"You are the GrowthAgent Competitive Intelligence Analyst (Layer 2). Analyze these recent feed items from TechCrunch and competitor news sources:\\n\\n\" + JSON.stringify($input.all().map(i => i.json)) + \"\\n\\nProduce a structured Competitive Intelligence Briefing in clean markdown with these sections:\\n1. **\ud83d\udd2c TechCrunch Research Highlights** \u2014 Summarize the most relevant clinical papers for CloudPulse (RPM, gait analysis, wearable insoles) and Synthetix AI (agentic LLM evaluation, sports science).\\n2. **\ud83c\udfe2 Competitor Activity** \u2014 What are Dynatrace, New Relic, Arize AI, LangSmith, Xsens doing? Any funding, product launches, partnerships, or hiring signals?\\n3. **\ud83d\udca1 Strategic Opportunities** \u2014 Based on this intelligence, what 2-3 actionable opportunities should CloudPulse and Synthetix AI capitalize on this week?\\n4. **\ud83d\udcca Trend Signals** \u2014 Any emerging themes or shifts in the market?\\n\\nKeep the briefing concise, executive-level, and formatted for Discord. Max 1500 characters.\" } ] } ], \"generationConfig\": { \"temperature\": 0.2, \"maxOutputTokens\": 700 } } }}",
        "options": {}
      },
      "id": "gemini-intel-summary",
      "name": "Gemini 2.5 Flash: Intelligence Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_PROJECT.supabase.co/rest/v1/GrowthAgent_memory",
        "sendHeaders": true,
